enum CampaignType {
  AUDIO
  BANNER
  MIXED
}

enum CampaignUserType {
  ALL
  FREE_USER
  PREMIUM_USER
}

enum CampaignPriority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model AdCampaign {
  id                  String                    @id @default(uuid())

  name                String
  description         String?

  campaignType        CampaignType                                          @map("campaign_type")

  userType            CampaignUserType          @default(ALL)               @map("user_type")

  startDate           DateTime?                 @db.Date                    @map("start_date")
  endDate             DateTime?                 @db.Date                    @map("end_date")

  priority            CampaignPriority          @default(MEDIUM)

  adsData             Json                      @map("ads_data")   // { audio: ["uuid1", "uuid2"], banners: ["uuid1", "uuid2"] }

  status              CampaignStatus            @default(ACTIVE)

  createdAt           DateTime            @default(now())     @map("created_at")
  updatedAt           DateTime            @updatedAt          @map("updated_at")

  @@map("ad_campaigns")
}

enum TargetType {
  FREE_USERS
  PREMIUM_USERS
  ALL
  SPECIFIC_USERS
}

model EmailNotification {
  id             String   @id @default(uuid())

  subject        String
  body           String   @map("email_body")

  senderId       String  @map("sender_id")

  targetType     TargetType @map("target_type")

  // Used only when targetType = SPECIFIC
  recipientIds   String[] @default([]) @map("recipient_ids")

  attachmentUrls String[] @default([]) @map("attachment_urls")

  isSent         Boolean  @default(false) @map("is_sent")
  sentAt         DateTime?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  sender         User @relation(fields: [senderId], references: [id])

  @@index([targetType])
  @@index([isSent])
  @@map("email_notifications")
}

enum PushNotificationActionType {
  OPEN_APP
  OPEN_SCREEN
}

model PushNotification {
  id                String   @id @default(uuid())

  title             String
  message           String

  senderId          String  @map("sender_id")

  targetType        TargetType @map("target_type")

  // Used only when targetType = SPECIFIC
  recipientIds      String[] @default([]) @map("recipient_ids")

  actionType        PushNotificationActionType    @default(OPEN_APP)          @map("action_type")

  // Used only when actionType = OPEN_SCREEN
  internalScreen    String?   @map("internal_screen")

  isSent            Boolean  @default(false) @map("is_sent")
  sentAt            DateTime?

  createdAt         DateTime @default(now())  @map("created_at")
  updatedAt         DateTime @updatedAt       @map("updated_at")

  sender            User @relation(fields: [senderId], references: [id])

  @@index([targetType])
  @@index([isSent])

  @@map("push_notifications")
}


enum ChannelTypeEnums {
  PUSH
  EMAIL
  BOTH
}

enum ScheduleTypeEnums {
  ONETIME
  RECURRING
}

enum RecurringOptionEnums {
  DAILY
  WEEKLY
  MONTHLY
}

model NotificationCampaign {
  id                String   @id @default(uuid())

  name              String
  description       String

  channelType       ChannelTypeEnums   @map("channel_type")

  // Used only when channelType = PUSH, BOTH
  title             String?
  message           String?

  // Used only when channelType = EMAIL, BOTH
  subject           String?
  body              String?

  startDate         DateTime?       @db.Date      @map("start_date")
  endDate           DateTime?       @db.Date      @map("end_date")

  scheduleType      ScheduleTypeEnums       @map("schedule_type")

  // Used only when scheduleType = RECURRING
  recurringOption   RecurringOptionEnums?    @map("recurring_option")

  targetType        TargetType @map("target_type")

  // Used only when targetType = SPECIFIC
  recipientIds      String[] @default([]) @map("recipient_ids")

  status            CampaignStatus            @default(ACTIVE)

  lastRunAt DateTime? @map("last_run_at")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@index([targetType])

  @@map("notification_campaigns")
}